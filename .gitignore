#env
.env
.env.*
!.env.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Nitro build output, once this app has a server. Both are regenerated by
# every build, and the deploy runs one before reading them.
.output
.wrangler

# Test coverage output (regenerated by `npm test -- --coverage`)
coverage

# Stale Base44 export diagnostic (verification artifact, superseded)
export-report.json

# Live hosted security reports (regenerated by every `node qa/hosted/verify-security.mjs`
# and `node qa/hosted/verify-entitlement.mjs` run; they embed real hosted project
# data, so they stay out of the repo)
qa/hosted/hosted-security-report.json
qa/hosted/entitlement-report.json
qa/hosted/browser-report.json
qa/hosted/routes-report.json

# Supabase CLI per-developer state (linked project ref, version check). Written
# by `supabase functions deploy` / `supabase link`; machine-local, not source.
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite
base44/.app.jsonc
