# ─ Node (Vite) client — never put secrets here ─────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─ Server-side (Supabase Edge Function secrets) ─────────────────────────────
# These are NOT VITE_*/NEXT_PUBLIC_* — they live on the deployed function via
# the Supabase CLI/dashboard and are never shipped to the browser.
#   LEMON_SQUEEZY_API_KEY=hint: generated in your Lemon Squeezy store
#   LEMON_SQUEEZY_WEBHOOK_SECRET=hint: your webhook signing secret
#   LEMON_SQUEEZY_STORE_ID=hint: numeric store id
#   LEMON_SQUEEZY_PRO_VARIANT_ID=hint: numeric variant id for PRO
#   LEMON_SQUEEZY_ULTIMATE_VARIANT_ID=hint: numeric variant id for ULTIMATE
#   LEMON_SQUEEZY_REDIRECT_URL=hint: post-checkout redirect (your /plans page)
#   GOOGLE_CALENDAR_CLIENT_ID=hint: OAuth client id with the Calendar API enabled
#   GOOGLE_CALENDAR_CLIENT_SECRET=hint: OAuth client secret
#   GOOGLE_CALENDAR_REDIRECT_URI=hint: https://<project>.supabase.co/functions/v1/google-calendar-sync
#   GOOGLE_CALENDAR_REDIRECT_URL=hint: where users land after connect (e.g. your /schedule page)
#   GOOGLE_DRIVE_CLIENT_ID=hint: OAuth client id with the Drive API enabled
#   GOOGLE_DRIVE_CLIENT_SECRET=hint: OAuth client secret
#   GOOGLE_DRIVE_REDIRECT_URI=hint: https://<project>.supabase.co/functions/v1/google-drive
#   GOOGLE_DRIVE_REDIRECT_URL=hint: where users land after connect (e.g. your /resources page)
#   OPENAI_API_KEY (ai-assistant function)